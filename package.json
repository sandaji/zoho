{
  "name": "zoho",
  "version": "1.0.0",
  "description": "A comprehensive Enterprise Resource Planning (ERP) system built with Next.js, TypeScript, and PostgreSQL.",
  "keywords": [
    "zoho",
    "erp",
    "nextjs",
    "typescript",
    "prisma",
    "postgresql"
  ],
  "homepage": "https://github.com/sandaji/zoho#readme",
  "bugs": {
    "url": "https://github.com/sandaji/zoho/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandaji/zoho.git"
  },
  "license": "ISC",
  "author": "ijamy vincent",
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd apps/api && npm run dev",
    "dev:frontend": "cd apps/web-portal && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd apps/api && npm run build",
    "build:frontend": "cd apps/web-portal && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd apps/api && npm start",
    "start:frontend": "cd apps/web-portal && npm start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd apps/api && npm test",
    "test:frontend": "cd apps/web-portal && npm test",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd apps/api && npm run lint",
    "lint:frontend": "cd apps/web-portal && npm run lint",
    "lint:fix": "npm run lint:fix:backend && npm run lint:fix:frontend",
    "lint:fix:backend": "cd apps/api && npm run lint:fix",
    "lint:fix:frontend": "cd apps/web-portal && npm run lint:fix",
    "type-check": "npm run type-check:backend && npm run type-check:frontend",
    "type-check:backend": "cd apps/api && npm run type-check",
    "type-check:frontend": "cd apps/web-portal && npm run type-check",
    "format": "npm run format:backend && npm run format:frontend",
    "format:backend": "cd apps/api && npm run format",
    "format:frontend": "cd apps/web-portal && npm run format",
    "db:generate": "cd apps/api && npm run db:generate",
    "db:migrate": "cd apps/api && npm run db:migrate",
    "db:seed": "cd apps/api && npm run db:seed",
    "db:studio": "cd apps/api && npm run db:studio",
    "clean": "npm run clean:backend && npm run clean:frontend",
    "clean:backend": "cd apps/api && rm -rf dist node_modules",
    "clean:frontend": "cd apps/web-portal && rm -rf .next node_modules",
    "install:all": "npm install && cd apps/web-portal && npm install && cd ../api && npm install"
  },
  "devDependencies": {
    "@next/swc-win32-x64-msvc": "16.3.5",
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0"
  },
  "allowScripts": {}
}
