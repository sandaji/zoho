  branch_id       String
  created_by      String
  created_at      DateTime  @default(now())
  branches        branches  @relation(fields: [branch_id], references: [id])

  @@index([branch_id])
  @@index([claim_period])
  @@index([created_at])
  @@index([etims_synced])
  @@index([source_type, source_id])
  @@index([transaction_no])
  @@index([vat_type])
}

model vendors {
  id              String            @id
  code            String            @unique
  name            String
  email           String?
  phone           String?
  address         String?
  tax_id          String?
  website         String?
  paymentTerms    String            @default("NET_30")
  leadTimeDays    Int               @default(7)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  products        products[]
  purchase_orders purchase_orders[]

  @@index([code])
  @@index([isActive])
  @@index([name])
}

model warehouses {
  id                                                                 String            @id
  code                                                               String            @unique
  name                                                               String
  location                                                           String
  capacity                                                           Int
  branchId                                                           String
  isActive                                                           Boolean           @default(true)
  createdAt                                                          DateTime          @default(now())
  updatedAt                                                          DateTime
  inventory                                                          inventory[]
  purchase_orders                                                    purchase_orders[]
  stock_batches                                                      stock_batches[]
  stock_movements                                                    stock_movements[]
  stock_transfers_stock_transfers_destinationWarehouseIdTowarehouses stock_transfers[] @relation("stock_transfers_destinationWarehouseIdTowarehouses")
  stock_transfers_stock_transfers_sourceWarehouseIdTowarehouses      stock_transfers[] @relation("stock_transfers_sourceWarehouseIdTowarehouses")
  branches                                                           branches          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([code])
  @@index([isActive])
}

