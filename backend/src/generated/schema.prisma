generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model accounts_payable {
  id           String        @id
  bill_no      String        @unique
  vendor_name  String
  vendor_email String?
  vendor_phone String?
  total_amount Float
  paid_amount  Float         @default(0)
  balance      Float
  bill_date    DateTime      @default(now())
  due_date     DateTime
  paid_date    DateTime?
  status       ap_status     @default(outstanding)
  aging_days   Int           @default(0)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  ap_payments  ap_payments[]

  @@index([bill_no])
  @@index([due_date])
  @@index([status])
  @@index([vendor_name])
}

model accounts_receivable {
  id             String        @id
  invoice_no     String        @unique
  customer_name  String
  customer_email String?
  customer_phone String?
  total_amount   Float
  paid_amount    Float         @default(0)
  balance        Float
  invoice_date   DateTime      @default(now())
  due_date       DateTime
  paid_date      DateTime?
  status         ar_status     @default(outstanding)
  aging_days     Int           @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  ar_payments    ar_payments[]

  @@index([customer_name])
  @@index([due_date])
  @@index([invoice_no])
  @@index([status])
}

model ap_payments {
  id               String           @id
  payment_no       String           @unique
  ap_id            String
  amount           Float
  payment_method   payment_method
  payment_date     DateTime         @default(now())
  bank_name        String?
  check_no         String?
  transaction_id   String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  accounts_payable accounts_payable @relation(fields: [ap_id], references: [id])

  @@index([ap_id])
  @@index([payment_date])
  @@index([payment_no])
}

model applicants {
  id           String          @id
  name         String
  email        String
  phone        String?
  resumeUrl    String?
  status       ApplicantStatus @default(NEW)
  jobPostingId String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime
  notes        String?
  job_postings job_postings    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews   interviews[]

  @@index([jobPostingId])
}

model approval_requests {
  id                                           String          @id
  type                                         approval_type
  status                                       approval_status @default(PENDING)
  requestedById                                String
  approvedById                                 String?
  data                                         Json
  referenceId                                  String?
  notes                                        String?
  createdAt                                    DateTime        @default(now())
  updatedAt                                    DateTime
  users_approval_requests_approvedByIdTousers  users?          @relation("approval_requests_approvedByIdTousers", fields: [approvedById], references: [id])
  users_approval_requests_requestedByIdTousers users           @relation("approval_requests_requestedByIdTousers", fields: [requestedById], references: [id])

  @@index([requestedById])
  @@index([status])
  @@index([type])
}

model ar_payments {
  id                  String              @id
  payment_no          String              @unique
  ar_id               String
  amount              Float
  payment_method      payment_method
  payment_date        DateTime            @default(now())
  bank_name           String?
  check_no            String?
  transaction_id      String?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  accounts_receivable accounts_receivable @relation(fields: [ar_id], references: [id])

  @@index([ar_id])
  @@index([payment_date])
  @@index([payment_no])
}

model audit_logs {
  id         String      @id
  entityType String
  entityId   String
  action     AuditAction
  userId     String?
  changes    Json
  ipAddress  String?
  timestamp  DateTime    @default(now())
  users      users?      @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
}

model bank_accounts {
  id                String              @id
  account_name      String
  account_number    String              @unique
  bank_name         String
  branch            String?
  account_type      bank_account_type   @default(checking)
  currency          String              @default("KES")
  current_balance   Float               @default(0)
  available_balance Float               @default(0)
  overdraft_limit   Float               @default(0)
  is_active         Boolean             @default(true)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  bank_transactions bank_transactions[]

  @@index([account_number])
  @@index([bank_name])
}

model bank_statement_lines {
  id               String           @id
  statement_id     String
  date             DateTime
  description      String
  amount           Float
  reference        String?
  is_reconciled    Boolean          @default(false)
  reconciled_date  DateTime?
  journal_entry_id String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  journal_entries  journal_entries? @relation(fields: [journal_entry_id], references: [id])
  bank_statements  bank_statements  @relation(fields: [statement_id], references: [id], onDelete: Cascade)

  @@index([amount])
  @@index([date])
  @@index([statement_id])
}

model bank_statements {
  id                   String                 @id
  account_id           String
  filename             String
  upload_date          DateTime               @default(now())
  uploaded_by          String
  start_date           DateTime?
  end_date             DateTime?
  status               String                 @default("pending")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  bank_statement_lines bank_statement_lines[]
  chart_of_accounts    chart_of_accounts      @relation(fields: [account_id], references: [id])

  @@index([account_id])
}

model bank_transactions {
  id               String           @id
  transaction_no   String           @unique
  bank_account_id  String
  transaction_type transaction_type
  amount           Float
  balance_after    Float
  description      String
  reference_no     String?
  category         String?
  is_reconciled    Boolean          @default(false)
  reconciled_date  DateTime?
  transaction_date DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  bank_accounts    bank_accounts    @relation(fields: [bank_account_id], references: [id])

  @@index([bank_account_id])
  @@index([transaction_date])
  @@index([transaction_no])
}

model benefit_enrollments {
  id         String   @id
  userId     String
  benefitId  String
  enrolledAt DateTime @default(now())
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  benefits   benefits @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, benefitId])
  @@index([benefitId])
  @@index([userId])
}

model benefits {
  id                  String                @id
  name                String
  type                String
  description         String?
  provider            String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  benefit_enrollments benefit_enrollments[]
}

model branch_inventory {
  id               String           @id
  productId        String
  branchId         String
  quantity         Int              @default(0)
  reorder_level    Int              @default(10)
  reorder_quantity Int              @default(20)
  reserved         Int              @default(0)
  available        Int              @default(0)
  status           inventory_status @default(in_stock)
  local_price      Float?
  bin_location     String?
  last_counted     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  branches         branches         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products         products         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([productId])
  @@index([status])
}

model branches {
  id                                                           String               @id
  code                                                         String               @unique
  name                                                         String
  city                                                         String
  address                                                      String?
  phone                                                        String?
  isActive                                                     Boolean              @default(true)
  createdAt                                                    DateTime             @default(now())
  updatedAt                                                    DateTime
  branch_inventory                                             branch_inventory[]
  cashier_sessions                                             cashier_sessions[]
  document_sequences                                           document_sequences[]
  employee_transfers_employee_transfers_fromBranchIdTobranches employee_transfers[] @relation("employee_transfers_fromBranchIdTobranches")
  employee_transfers_employee_transfers_toBranchIdTobranches   employee_transfers[] @relation("employee_transfers_toBranchIdTobranches")
  journal_headers                                              journal_headers[]
  purchase_orders                                              purchase_orders[]
  sales_documents                                              sales_documents[]
  sales_orders                                                 sales_orders[]
  users                                                        users[]
  vat_transactions                                             vat_transactions[]
  warehouses                                                   warehouses[]

  @@index([code])
  @@index([isActive])
}

model budgets {
  id                String            @id
  budget_name       String
  fiscal_year       Int
  account_id        String
  period_type       period_type       @default(monthly)
  period_start      DateTime
  period_end        DateTime
  budgeted_amount   Float
  actual_amount     Float             @default(0)
  variance          Float             @default(0)
  variance_percent  Float             @default(0)
  status            budget_status     @default(draft)
  created_by        String
  approved_by       String?
  approved_date     DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  chart_of_accounts chart_of_accounts @relation(fields: [account_id], references: [id])

  @@unique([account_id, fiscal_year, period_start])
  @@index([account_id])
  @@index([fiscal_year])
  @@index([status])
}

model cashier_sessions {
  id                   String                 @id
  sessionNo            String                 @unique
  userId               String
  branchId             String
  opening_balance      Float                  @default(0)
  closing_balance      Float?
  expected_cash        Float?
  actual_cash          Float?
  cash_variance        Float?
  total_sales_count    Int                    @default(0)
  total_sales_amount   Float                  @default(0)
  total_cash_received  Float                  @default(0)
  total_card_received  Float                  @default(0)
  total_mpesa_received Float                  @default(0)
  total_other_received Float                  @default(0)
  opened_at            DateTime               @default(now())
  closed_at            DateTime?
  reconciled_at        DateTime?
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  status               cashier_session_status @default(OPEN)
  branches             branches               @relation(fields: [branchId], references: [id])
  users                users                  @relation(fields: [userId], references: [id])
  sales_documents      sales_documents[]

  @@unique([branchId, sessionNo])
  @@index([branchId])
  @@index([opened_at])
  @@index([sessionNo])
  @@index([status])
  @@index([userId])
}

model categories {
  id            String          @id
  name          String          @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  subcategories subcategories[]

  @@index([name])
}

model chart_of_accounts {
  id                      String              @id
  account_code            String              @unique
  account_name            String
  account_type            account_type
  parent_id               String?
  category                String
  subcategory             String?
  is_active               Boolean             @default(true)
  is_system               Boolean             @default(false)
  current_balance         Float               @default(0)
  description             String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime
  bank_statements         bank_statements[]
  budgets                 budgets[]
  chart_of_accounts       chart_of_accounts?  @relation("chart_of_accountsTochart_of_accounts", fields: [parent_id], references: [id])
  other_chart_of_accounts chart_of_accounts[] @relation("chart_of_accountsTochart_of_accounts")
  journal_entries         journal_entries[]
  journal_lines           journal_lines[]

  @@index([account_code])
  @@index([account_type])
  @@index([category])
}

model customer_code_settings {
  id          String   @id
  prefix      String   @db.VarChar(2)
  next_number Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model customers {
  id              String            @id
  name            String            @unique
  email           String?           @unique
  phone           String?
  address         String?
  tax_id          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  creditLimit     Decimal           @default(0.00)
  currentBalance  Decimal           @default(0.00)
  customerType    String            @default("RETAIL")
  isActive        Boolean           @default(true)
  code            String            @unique
  payments        payments[]
  sales_documents sales_documents[]
  sales_orders    sales_orders[]

  @@index([email])
  @@index([name])
  @@index([phone])
}

model daily_spending_limits {
  id        String   @id
  limit     Float    @default(50000)
  date      DateTime @unique
  spent     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([date])
}

model deliveries {
  id                      String                    @id
  delivery_no             String                    @unique
  status                  delivery_status           @default(pending)
  driverId                String
  truckId                 String
  destination             String?
  estimated_km            Int?
  actual_km               Int?
  scheduled_date          DateTime?
  picked_up_at            DateTime?
  delivered_at            DateTime?
  notes                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  deliveryOtp             String?
  podPhotoUrl             String?
  podSignatureUrl         String?
  users                   users                     @relation(fields: [driverId], references: [id])
  trucks                  trucks                    @relation(fields: [truckId], references: [id])
  delivery_dispatch_notes delivery_dispatch_notes[]

  @@index([delivery_no])
  @@index([driverId])
  @@index([status])
  @@index([truckId])
}

model delivery_dispatch_notes {
  id             String         @id
  deliveryId     String
  dispatchNoteId String
  deliveries     deliveries     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  dispatch_notes dispatch_notes @relation(fields: [dispatchNoteId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, dispatchNoteId])
  @@index([deliveryId])
  @@index([dispatchNoteId])
}

model departments {
  id          String   @id
  name        String   @unique
  prefix      String   @unique @db.VarChar(2)
  next_number Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       users[]

  @@index([isActive])
}

model development_plans {
  id          String   @id
  userId      String
  title       String
  description String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model dispatch_items {
  id             String         @id
  dispatchNoteId String
  soItemId       String
  productId      String
  qty_dispatched Int
  total_cogs     Decimal
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  dispatch_notes dispatch_notes @relation(fields: [dispatchNoteId], references: [id], onDelete: Cascade)
  products       products       @relation(fields: [productId], references: [id])
  so_items       so_items       @relation(fields: [soItemId], references: [id])

  @@index([dispatchNoteId])
  @@index([productId])
  @@index([soItemId])
}

model dispatch_notes {
  id                      String                    @id
  dn_number               String                    @unique
  salesOrderId            String
  dispatchedById          String
  dispatched_at           DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  delivery_dispatch_notes delivery_dispatch_notes[]
  dispatch_items          dispatch_items[]
  users                   users                     @relation(fields: [dispatchedById], references: [id])
  sales_orders            sales_orders              @relation(fields: [salesOrderId], references: [id])

  @@index([dispatchedById])
  @@index([dispatched_at])
  @@index([dn_number])
  @@index([salesOrderId])
}

model document_sequences {
  id          String              @id
  branchId    String
  type        sales_document_type
  prefix      String
  next_number Int                 @default(1)
  branches    branches            @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, type])
  @@index([branchId])
}

model employee_transfers {
  id                                                 String    @id
  userId                                             String
  fromBranchId                                       String?
  toBranchId                                         String
  transferDate                                       DateTime  @default(now())
  effectiveDate                                      DateTime
  reason                                             String?
  approvedBy                                         String?
  approvedAt                                         DateTime?
  notes                                              String?
  createdAt                                          DateTime  @default(now())
  updatedAt                                          DateTime
  fromRole                                           String?
  toRole                                             String
  branches_employee_transfers_fromBranchIdTobranches branches? @relation("employee_transfers_fromBranchIdTobranches", fields: [fromBranchId], references: [id])
  branches_employee_transfers_toBranchIdTobranches   branches  @relation("employee_transfers_toBranchIdTobranches", fields: [toBranchId], references: [id])
  users                                              users     @relation(fields: [userId], references: [id])

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([transferDate])
  @@index([userId])
}

model finance_transactions {
  id              String           @id
  type            transaction_type
  reference_no    String           @unique
  description     String
  amount          Float
  payrollId       String?
  payment_method  String?
  reference_doc   String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  category        String?
  transactionDate DateTime         @default(now())
  payroll         payroll?         @relation(fields: [payrollId], references: [id])

  @@index([category])
  @@index([payrollId])
  @@index([reference_no])
  @@index([transactionDate])
  @@index([type])
}

model financial_alerts {
  id              String         @id
  alert_type      alert_type
  severity        alert_severity @default(medium)
  title           String
  message         String
  threshold_value Float?
  current_value   Float?
  status          alert_status   @default(active)
  acknowledged_by String?
  acknowledged_at DateTime?
  resolved_at     DateTime?
  recipients      Json
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime

  @@index([alert_type])
  @@index([severity])
  @@index([status])
}

model financial_forecasts {
  id             String          @id
  forecast_name  String
  forecast_type  forecast_type
  fiscal_year    Int
  period_start   DateTime
  period_end     DateTime
  forecast_data  Json
  actual_data    Json?
  accuracy_score Float?
  mape           Float?
  model_type     String?
  model_params   Json?
  status         forecast_status @default(draft)
  created_by     String
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime

  @@index([fiscal_year])
  @@index([forecast_type])
  @@index([status])
}

model fiscal_periods {
  id              String            @id
  fiscal_year_id  String
  name            String
  start_date      DateTime
  end_date        DateTime
  status          fiscal_status     @default(open)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  isLocked        Boolean           @default(false)
  lockedAt        DateTime?
  lockedById      String?
  fiscal_years    fiscal_years      @relation(fields: [fiscal_year_id], references: [id])
  users           users?            @relation(fields: [lockedById], references: [id])
  journal_entries journal_entries[]
  journal_headers journal_headers[]

  @@index([lockedById])
}

model fiscal_years {
  id             String           @id
  name           String
  start_date     DateTime
  end_date       DateTime
  status         fiscal_status    @default(open)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  fiscal_periods fiscal_periods[]
}

model goods_receipt_notes {
  id              String          @id
  grn_number      String          @unique
  purchaseOrderId String
  receivedById    String
  status          grn_status      @default(COMPLETED)
  receivedAt      DateTime        @default(now())
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  purchase_orders purchase_orders @relation(fields: [purchaseOrderId], references: [id])
  users           users           @relation(fields: [receivedById], references: [id])
  grn_items       grn_items[]

  @@index([grn_number])
  @@index([purchaseOrderId])
  @@index([status])
}

model grn_items {
  id                   String               @id
  grnId                String
  poItemId             String
  productId            String
  qty_received         Int
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  goods_receipt_notes  goods_receipt_notes  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchase_order_items purchase_order_items @relation(fields: [poItemId], references: [id])
  products             products             @relation(fields: [productId], references: [id])
  stock_batches        stock_batches[]

  @@index([grnId])
  @@index([poItemId])
}

model interviews {
  id            String          @id
  applicantId   String
  interviewerId String
  scheduledAt   DateTime
  feedback      String?
  rating        Int?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  applicants    applicants      @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  users         users           @relation(fields: [interviewerId], references: [id])

  @@index([applicantId])
  @@index([interviewerId])
}

model inventory {
  id           String           @id
  quantity     Int              @default(0)
  reserved     Int              @default(0)
  available    Int              @default(0)
  status       inventory_status @default(in_stock)
  last_counted DateTime?
  productId    String
  warehouseId  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime
  products     products         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouses   warehouses       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([status])
  @@index([warehouseId])
}

model job_postings {
  id          String           @id
  title       String
  description String
  department  String
  location    String?
  type        String?
  status      JobPostingStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  applicants  applicants[]
}

model journal_entries {
  id                   String                @id
  entry_no             String                @unique
  entry_date           DateTime              @default(now())
  account_id           String
  debit                Float                 @default(0)
  credit               Float                 @default(0)
  reference_type       String?
  reference_id         String?
  batch_id             String?
  description          String
  notes                String?
  is_reconciled        Boolean               @default(false)
  reconciled_date      DateTime?
  created_by           String
  approved_by          String?
  approved_date        DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  journal_id           String?
  period_id            String?
  bank_statement_lines bank_statement_lines?
  chart_of_accounts    chart_of_accounts     @relation(fields: [account_id], references: [id])
  journals             journals?             @relation(fields: [journal_id], references: [id])
  fiscal_periods       fiscal_periods?       @relation(fields: [period_id], references: [id])

  @@index([account_id])
  @@index([batch_id])
  @@index([entry_date])
  @@index([entry_no])
  @@index([journal_id])
  @@index([period_id])
  @@index([reference_type, reference_id])
}

model journal_headers {
  id             String          @id
  entry_no       String          @unique
  entry_date     DateTime
  period_id      String
  journal_id     String?
  branch_id      String?
  description    String
  total_debit    Decimal         @db.Decimal(19, 2)
  total_credit   Decimal         @db.Decimal(19, 2)
  source_type    String?
  source_id      String?
  created_by     String
  created_at     DateTime        @default(now())
  branches       branches?       @relation(fields: [branch_id], references: [id])
  journals       journals?       @relation(fields: [journal_id], references: [id])
  fiscal_periods fiscal_periods  @relation(fields: [period_id], references: [id])
  journal_lines  journal_lines[]

  @@index([branch_id])
  @@index([entry_date])
  @@index([entry_no])
  @@index([period_id])
  @@index([source_type, source_id])
}

model journal_lines {
  id                String            @id
  header_id         String
  account_id        String
  line_no           Int
  description       String?
