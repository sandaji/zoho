{
  "name": "zoho_backend",
  "version": "1.0.0",
  "description": "A robust Node.js + TypeScript backend API for the Zoho ERP system built with Express and Prisma.",
  "license": "ISC",
  "author": "ijamy vincent",
  "type": "module",
  "main": "index.ts",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "npx prisma generate && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db push && prisma generate && prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "perf:migrate": "prisma migrate deploy",
    "perf:verify": "tsx scripts/verify-performance.ts",
    "assign-role": "tsx scripts/assign-role.ts",
    "migrate:sales": "tsx scripts/migrate-sales-to-documents.ts",
    "migrate:sales:dry-run": "tsx scripts/migrate-sales-to-documents.ts --dry-run",
    "verify:sales-migration": "tsx scripts/verify-sales-migration.ts",
    "test": "jest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.8.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "jest": "^30.4.2",
    "prisma": "7.9.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12"
  }
}
